# Copy to .env and adjust. Every value has a sensible default.
POSTGRES_USER=safe
POSTGRES_PASSWORD=safe
POSTGRES_DB=saferoute
# host port for Postgres
DB_PORT=5432
# host port for the API
API_PORT=5000

# Study area: circle around USC (University Park)
USC_LAT=34.0224
USC_LNG=-118.2851
# 5 miles: must match risk-model/common/config.py RADIUS_MILES
RADIUS_KM=8.047
# The walk graph extends this far past the circle (routes near the edge)
ROAD_MARGIN_KM=1.5
# fine cells (~0.1 km^2) used for features
H3_RES=9
# coarse cells (~36 km^2) for area-wide signals (sun, weather)
H3_AREA_RES=6

# Poll intervals (minutes) per ingestion source
POLL_SUN_MINUTES=1
POLL_OPENMETEO_MINUTES=5
POLL_NWS_MINUTES=10
POLL_LAPD_MINUTES=60
POLL_LA311_MINUTES=30

# Socrata (data.lacity.org) — free app token raises rate limits
SOCRATA_APP_TOKEN=
# "Crime Data from 2020 to 2024" (legacy, frozen)
LAPD_DATASET_ID=2nrs-mtv8
# first-run backfill start for the legacy dataset
CRIME_BACKFILL_START=2024-01-01
# "LAPD NIBRS Offenses Dataset" (2025+, ~weekly updates)
LAPD_NIBRS_DATASET_ID=k7nn-b2ep
# starts where the legacy dataset ends (no double counting)
NIBRS_BACKFILL_START=2025-01-01
# MyLA311 dataset id for the current year; empty = disabled
LA311_DATASET_ID=

# USC/Downtown first, LAX fallback; offline stations are skipped
NWS_STATIONS=KCQT,KLAX
HTTP_USER_AGENT=usc-safe-route-hackathon

# API processes: each holds the risk model (~600 MB), so prefer threads over workers
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Optional: require X-Admin-Token header on /api/v1/admin/*
ADMIN_TOKEN=

# Place search (README "Search API"). Each API worker keeps an in-memory index (~90 MB) and,
# with semantic search on, an embedding model (~150 MB).
# auto = meaning-based matching when fastembed + stored vectors are available; on | off
SEARCH_SEMANTIC=auto
# Must be the model scripts.load_places embedded with (the Docker image pre-downloads it)
SEARCH_EMBED_MODEL=BAAI/bge-small-en-v1.5
# onnxruntime threads per query embedding
SEARCH_EMBED_THREADS=1
# Seconds between "did the places table change?" checks (search_meta.places_version)
SEARCH_INDEX_TTL=60

# Sign-in (Google OAuth, @usc.edu only). See README "Auth".
# Keep every comment on its own line: Docker Compose reads a trailing comment as the value when the value is empty.
# Required for sign-in: >= 32 random chars, same value on every API process.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback registered in Google. Empty = derived from the request (works behind nginx via X-Forwarded-*).
# Production: https://<api or frontend host>/api/v1/auth/callback
OAUTH_REDIRECT_URI=
# Frontend origins (comma-separated): CORS allow-list with credentials, and the only allowed `next` targets
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173
# Frontend on a different site calling the API directly: None + true (HTTPS only).
# Same origin (frontend host proxies /api) or same site: keep Lax.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
# true = /api/v1/auth/dev/login without Google; local testing only, never in production
AUTH_DEV_LOGIN=false

# Demo recordings: simulated crimes from the frontend's Demo page (/api/v1/demo/*). Keep false in production
# except while recording; writes need a signed-in user. See README "Demo mode".
DEMO_MODE=false
DEMO_INCIDENT_TTL_MIN=60
DEMO_INCIDENT_RADIUS_M=120
